<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FactoryConnect - Painel Industrial</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body class="bg-light">

  <!-- EXERCÍCIO 3 & 4: Navbar responsiva com marca, 3 links, toggler e collapse -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#">FactoryConnect</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarFactory" aria-controls="navbarFactory" aria-expanded="false" aria-label="Alternar navegação">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarFactory">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="#areas">Áreas</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#maquinas">Máquinas</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#alertas">Alertas</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>RRF

  <main class="container my-5">

    <!-- EXERCÍCIO 6: Alertas industriais (success, warning, danger) -->
    <section id="alertas" class="mb-5">
      <h2 class="h4 mb-3 text-secondary border-bottom pb-2">Alertas do Sistema</h2>
      
      <div class="alert alert-success d-flex align-items-center" role="alert">
        <div>
          <strong>Operação normalizada:</strong> Lote #408 concluído dentro da meta de eficiência (OEE 94%).
        </div>
      </div>

      <div class="alert alert-warning d-flex align-items-center" role="alert">
        <div>
          <strong>Atenção preventiva:</strong> Temperatura do motor da Esteira 02 atingiu 78°C — agendar inspeção.
        </div>
      </div>

      <div class="alert alert-danger d-flex align-items-center" role="alert">
        <div>
          <strong>Parada crítica:</strong> Queda de pressão hidráulica detectada na Injetora-02 — bloqueio automático acionado.
        </div>
      </div>
    </section>

    <!-- EXERCÍCIO 1 & 2: Grade com 6 cards das áreas FactoryConnect usando row-cols-* e h-100 -->
    <section id="areas" class="mb-5">
      <h2 class="h4 mb-3 text-secondary border-bottom pb-2">Áreas FactoryConnect</h2>
      
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        
        <!-- Card 1 (Produção - Exercício 1 integrado na grade) -->
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-primary">Produção</h5>
              <p class="card-text flex-grow-1">Monitoramento em tempo real das linhas de montagem, metas por turno e indicadores OEE.</p>
              <a href="#" class="btn btn-primary mt-2">Acessar Produção</a>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-primary">Manutenção</h5>
              <p class="card-text flex-grow-1">Gestão de ordens de serviço preventivas, preditivas e controle de disponibilidade de ativos.</p>
              <a href="#" class="btn btn-outline-primary mt-2">Acessar Manutenção</a>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-primary">Qualidade</h5>
              <p class="card-text flex-grow-1">Inspeção de lotes, controle estatístico de processo (CEP) e rastreabilidade de não conformidades.</p>
              <a href="#" class="btn btn-outline-primary mt-2">Acessar Qualidade</a>
            </div>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-primary">Logística</h5>
              <p class="card-text flex-grow-1">Abastecimento inteligente de linhas, movimentação interna (AGVs) e inventário em tempo real.</p>
              <a href="#" class="btn btn-outline-primary mt-2">Acessar Logística</a>
            </div>
          </div>
        </div>

        <!-- Card 5 -->
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-primary">Engenharia</h5>
              <p class="card-text flex-grow-1">Especificações técnicas, roteiros de fabricação, balanceamento de linha e tempos padrão.</p>
              <a href="#" class="btn btn-outline-primary mt-2">Acessar Engenharia</a>
            </div>
          </div>
        </div>

        <!-- Card 6 -->
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-primary">Segurança (HSE)</h5>
              <p class="card-text flex-grow-1">Monitoramento de zonas de risco, bloqueios LOTO, EPIs e indicadores ambientais da planta.</p>
              <a href="#" class="btn btn-outline-primary mt-2">Acessar Segurança</a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- EXERCÍCIO 5: Estados industriais com badges (Operando, Manutenção, Parada) -->
    <section id="maquinas" class="mb-4">
      <h2 class="h4 mb-3 text-secondary border-bottom pb-2">Status das Máquinas</h2>
      
      <div class="card shadow-sm">
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center py-3">
            <div>
              <strong>Torno CNC-01</strong>
              <span class="text-muted d-block small">Linha de Usinagem A — Turno 1</span>
            </div>
            <span class="badge bg-success rounded-pill px-3 py-2">Operando</span>
          </li>
          
          <li class="list-group-item d-flex justify-content-between align-items-center py-3">
            <div>
              <strong>Prensa Hidráulica-04</strong>
              <span class="text-muted d-block small">Estamparia — Calibração programada</span>
            </div>
            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Manutenção</span>
          </li>
          
          <li class="list-group-item d-flex justify-content-between align-items-center py-3">
            <div>
              <strong>Injetora-02</strong>
              <span class="text-muted d-block small">Polímeros — Falha de pressão</span>
            </div>
            <span class="badge bg-danger rounded-pill px-3 py-2">Parada</span>
          </li>
        </ul>
      </div>
    </section>

  </main>

  <footer class="bg-dark text-white-50 text-center py-3 mt-5">
    <small>FactoryConnect &copy; Painel de Monitoramento Industrial</small>
  </footer>

  <!-- Script do Bootstrap (necessário para o funcionamento do Collapse da Navbar no Exercício 4) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
